import sys
import os
from PIL import Image
import numpy as np

def extract_alpha(src_path, dst_path):
    im = Image.open(src_path).convert('RGBA')
    data = np.array(im, dtype=np.float32)
    r, g, b = data[:,:,0], data[:,:,1], data[:,:,2]

    mag_diff = np.minimum(r, b) - g
    alpha = 1.0 - np.clip((mag_diff - 30.0) / 40.0, 0.0, 1.0)
    data[:,:,3] = alpha * 255.0

    excess_r = np.maximum(0.0, r - g)
    excess_b = np.maximum(0.0, b - g)
    despill_weight = np.clip((1.0 - alpha) * 2.0, 0.0, 1.0)
    data[:,:,0] -= excess_r * despill_weight * 0.5
    data[:,:,2] -= excess_b * despill_weight * 0.5

    out = Image.fromarray(np.clip(data, 0, 255).astype(np.uint8))
    out.save(dst_path)
    
    min_a, max_a = out.getchannel('A').getextrema()
    print(f"Saved {dst_path}: size={out.size}, alpha min={min_a}, max={max_a}")
    return min_a == 0 and max_a > 0

if __name__ == '__main__':
    if len(sys.argv) < 3:
        print("Usage: key_magenta.py <src> <dst>")
        sys.exit(1)
    ok = extract_alpha(sys.argv[1], sys.argv[2])
    sys.exit(0 if ok else 1)
